{
  "expo": {
    "name": "uroflow-app",
    "slug": "uroflow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/uroflow-logo.png",
    "scheme": "uroflowapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/uroflow-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/uroflow-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lifesystems.uroflow"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "150116b8-d3a6-4de3-af82-041032404ab0"
      }
    }
  }
}
